# کلید مدل — بدون این، موتور (vision/speech/generate) خطای ۵۰۳ برمی‌گرداند
OPENAI_API_KEY=

# اختیاری — نام مدل‌ها (پیش‌فرض‌ها معمولاً کافی‌اند)
CATALOGYAR_VISION_MODEL=gpt-4o-mini
CATALOGYAR_SPEECH_MODEL=whisper-1
CATALOGYAR_GENERATE_MODEL=gpt-4o-mini

# ذخیره‌سازی و cache
CATALOGYAR_DATA_DIR=/tmp/catalogyar
CATALOGYAR_DATABASE_PATH=/tmp/catalogyar/catalogyar.sqlite3
CATALOGYAR_VISION_CACHE_DIR=/tmp/catalogyar/vision-cache

# احراز هویت seller-scoped: seller_id:api_key,seller2:api_key2
# اگر خالی باشد، محیط development بدون کلید اجرا می‌شود.
CATALOGYAR_API_KEYS=
CATALOGYAR_RATE_LIMIT_PER_MINUTE=30

# انتشار بازارگاه‌ها
DIGIKALA_PUBLISH_URL=
DIGIKALA_TOKEN=
BASALAM_PUBLISH_URL=
BASALAM_TOKEN=
TOROB_PUBLISH_URL=
TOROB_TOKEN=
CATALOGYAR_REQUEST_TIMEOUT_SECONDS=12
